# Runtime connection. In production (Vercel + Supabase) use the TRANSACTION
# pooler, port 6543, with ?pgbouncer=true&connection_limit=1 — the session
# pooler (5432) runs out of connections under serverless load.
DATABASE_URL="postgresql://user:password@localhost:5432/haske_community?schema=public"
# Migrations connection: Supabase session pooler (port 5432) or direct.
DIRECT_URL="postgresql://user:password@localhost:5432/haske_community?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Haske Community"

# Email provider: "console" (dev, logs to stdout) | "resend"
EMAIL_PROVIDER="console"
EMAIL_FROM="Haske Community <no-reply@haskecommunity.ng>"
RESEND_API_KEY=""

# Storage provider: "local" (dev, filesystem) | "s3"
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# Seeded account passwords (prisma/seed.ts, scripts/setup-credentials.ts).
# Minimum 12 characters. Leave blank to keep an existing account's password;
# a new account created without one can't sign in until it's set.
# Never commit real values — set production ones in your deploy environment.
SEED_ADMIN_PASSWORD=""
SEED_HASKE_PASSWORD=""
SEED_TEAM_PASSWORD=""
# Localhost-only test accounts (skipped when DATABASE_URL isn't local).
SEED_TEST_ADMIN_PASSWORD=""
SEED_TEST_USER_PASSWORD=""

# Web Push notifications. Generate a key pair with:
#   npx web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY secret. Leave blank to disable push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@haskecommunity.ng"

# Program payout (bank) details. Without both keys, bank-detail collection
# stays disabled. Generate each with: openssl rand -base64 32
# Keep PAYOUT_ENCRYPTION_KEY in your password manager: losing it makes stored
# account numbers unreadable. Never reuse development values in production.
PAYOUT_ENCRYPTION_KEY=""
PAYOUT_HASH_KEY=""
# Optional: Paystack secret key for the live bank list and account-name checks.
PAYSTACK_SECRET_KEY=""
# Protects the daily retention job (/api/cron/payout-retention). Vercel Cron
# sends it automatically once set. Generate with: openssl rand -hex 32
CRON_SECRET=""
