DATABASE_URL="postgresql://user:password@localhost:5432/haske_community?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Haske Community"

# Email provider: "console" (dev, logs to stdout) | "resend"
EMAIL_PROVIDER="console"
EMAIL_FROM="Haske Community <no-reply@haskecommunity.ng>"
RESEND_API_KEY=""

# Storage provider: "local" (dev, filesystem) | "s3"
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# Seeded account passwords (prisma/seed.ts, scripts/setup-credentials.ts).
# Minimum 12 characters. Leave blank to keep an existing account's password;
# a new account created without one can't sign in until it's set.
# Never commit real values — set production ones in your deploy environment.
SEED_ADMIN_PASSWORD=""
SEED_HASKE_PASSWORD=""
SEED_TEAM_PASSWORD=""
# Localhost-only test accounts (skipped when DATABASE_URL isn't local).
SEED_TEST_ADMIN_PASSWORD=""
SEED_TEST_USER_PASSWORD=""
